        <mxCell id="a2" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;align=center;verticalAlign=middle;spacing=6;shadow=0;shape=swimlane;horizontal=1;startSize=44;rounded=0;fillColor=#d5e8d4;swimlaneFillColor=light-dark(#edf6f2, #121212);strokeColor=#82b366;strokeWidth=1.4;fontSize=20;fontStyle=1;collapsible=0;recursiveResize=0;container=1;resizeLast=0;" value="02 · Telemetry-Quality-Aware Graph Encoder" vertex="1">
          <mxGeometry height="480" width="465" x="30" y="332" as="geometry" />
        </mxCell>
        <mxCell id="a2_proj" parent="a2" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=6;shadow=0;gradientColor=none;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EDF6F1;strokeColor=#5B816B;strokeWidth=1.2;fontStyle=0;dashed=0;" value="&lt;div&gt;&lt;b&gt;[Trainable]&amp;nbsp;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Node projection&lt;/b&gt;&lt;br&gt;\(\mathbb R^{10}\rightarrow\mathbb R^{56}\)&lt;br&gt;\(H_0=\mathrm{ReLU}(W_{in}X+b)\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="113" width="198" x="12" y="58" as="geometry" />
        </mxCell>
        <mxCell id="a2_adj" parent="a2" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=6;shadow=0;gradientColor=none;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#5B816B;strokeWidth=1.2;fontStyle=0;dashed=0;" value="&lt;div&gt;&lt;b&gt;[Deterministic] Graph normalization&lt;/b&gt;&lt;br&gt;\(\widehat A=D^{-1/2}(A+I)D^{-1/2}\)&lt;br&gt;masked padded nodes excluded&lt;/div&gt;" vertex="1">
          <mxGeometry height="112" width="210" x="236" y="58" as="geometry" />
        </mxCell>
        <mxCell id="a2_gcn" parent="a2" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=6;shadow=0;gradientColor=none;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#F7FBF8;strokeColor=#5B816B;strokeWidth=1.2;fontStyle=0;dashed=0;" value="&lt;div&gt;&lt;b&gt;[Trainable] Two graph-propagation steps&lt;/b&gt;&lt;br&gt;\(H_1=\mathrm{ReLU}(\widehat A H_0)\)&lt;br&gt;\(H_2=\mathrm{ReLU}(W_hH_1+b_h)\)&lt;br&gt;\(H_3=\mathrm{ReLU}(\widehat A H_2)\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="103" width="430.5" x="17.5" y="204" as="geometry" />
        </mxCell>
        <mxCell id="a2_rel" parent="a2" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=6;shadow=0;gradientColor=none;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#5B816B;strokeWidth=1.2;fontStyle=0;dashed=0;" value="&lt;div&gt;&lt;b&gt;[Trainable] Learned telemetry weighting&lt;/b&gt;&lt;br&gt;\([o_i,\widetilde a_i]\in\mathbb R^2\rightarrow12\rightarrow1\)&lt;br&gt;\(\widetilde a_i=a_i/4,\quad r_i=\sigma(W_2\,\mathrm{ReLU}(W_1[o_i,\widetilde a_i]))\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="142" width="202" x="17.5" y="330" as="geometry" />
        </mxCell>
        <mxCell id="a2_pool" parent="a2" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=6;shadow=0;gradientColor=none;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EDF6F1;strokeColor=#5B816B;strokeWidth=1.2;fontStyle=0;dashed=0;" value="&lt;div&gt;&lt;b&gt;Telemetry-quality-weighted pooling&lt;/b&gt;&lt;br&gt;\(\alpha_i=\frac{r_i m_i}{\sum_j r_jm_j}\)&lt;br&gt;\(\bar h=\sum_i\alpha_iH_{3,i}\in\mathbb R^{56}\)&lt;br&gt;\(h_{\max}=\max_i H_{3,i}\in\mathbb R^{56}\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="211" x="235" y="332" as="geometry" />
        </mxCell>
