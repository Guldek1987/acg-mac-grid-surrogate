          <mxGeometry height="72" width="391" x="14" y="55" as="geometry" />
        </mxCell>
        <mxCell id="g3_b" parent="g3" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=6;shadow=0;gradientColor=none;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFF9F2;strokeColor=#9A7854;strokeWidth=1.2;fontStyle=0;dashed=0;" value="&lt;div&gt;&lt;b&gt;Scientific targets&lt;/b&gt;&lt;br&gt;\(y=[V_{\min},L_{\rm kW},c]\)&lt;br&gt;\(c=\mathbf1[\mathrm{conv}\land 0.95\le V_{\min}\land V_{\max}\le1.05]\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="72" width="391" x="14" y="140" as="geometry" />
        </mxCell>
        <mxCell id="g3_c" parent="g3" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=6;shadow=0;gradientColor=none;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#9A7854;strokeWidth=1.2;fontStyle=0;dashed=0;" value="&lt;div&gt;&lt;b&gt;Communication / telemetry degradation&lt;/b&gt;&lt;br&gt;scenario missingness parameter \(\rho\sim U(0,0.20)\)&lt;br&gt;\(o_i\sim\mathrm{Bernoulli}(1-\rho)\); slack node always observed&lt;br&gt;age \(a_i\in[0,4]\); noise \(\sigma_i=0.005+0.012a_i\); missing \(P_i,Q_i\rightarrow\mathrm{NaN}\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="149" width="391" x="14" y="226" as="geometry" />
        </mxCell>
        <mxCell id="g4" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=6;shadow=0;gradientColor=none;shape=swimlane;horizontal=1;startSize=44;rounded=0;fillColor=#F4F0FA;swimlaneFillColor=#FFFFFF;strokeColor=#76658B;strokeWidth=1.4;fontSize=20;fontStyle=1;collapsible=0;recursiveResize=0;container=1;resizeLast=0;" value="04 · Imputation and Model Representations" vertex="1">
