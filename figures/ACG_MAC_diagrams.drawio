        <mxCell id="g2_a" parent="g2" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=6;shadow=0;gradientColor=none;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EDF6F1;strokeColor=#5B816B;strokeWidth=1.2;fontStyle=0;dashed=0;" value="&lt;div&gt;&lt;b&gt;Operating-state factors&lt;/b&gt;&lt;br&gt;hour · day-of-year · weekday&lt;br&gt;global loading \(g\sim U(0.72,1.30)\) + nodal lognormal variability&lt;/div&gt;" vertex="1">
          <mxGeometry height="92" width="326" x="14" y="55" as="geometry" />
        </mxCell>
        <mxCell id="g2_b" parent="g2" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=6;shadow=0;gradientColor=none;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#F7FBF8;strokeColor=#5B816B;strokeWidth=1.2;fontStyle=0;dashed=0;" value="&lt;div&gt;&lt;b&gt;Load-state synthesis&lt;/b&gt;&lt;br&gt;\(P_i=P_i^{0}s_i,\quad Q_i=Q_i^{0}s_i\epsilon_i\)&lt;br&gt;daily + seasonal + weekend modulation&lt;br&gt;stress factor clipped to \(s_i\in[0.35,1.65]\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="104" width="325" x="14" y="161" as="geometry" />
        </mxCell>
        <mxCell id="g2_c" parent="g2" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=6;shadow=0;gradientColor=none;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#5B816B;strokeWidth=1.2;fontStyle=0;dashed=0;" value="&lt;div&gt;&lt;b&gt;Topology and source-voltage sampling&lt;/b&gt;&lt;br&gt;case33bw: 60 enumerated radial topologies&lt;br&gt;\(V_s\sim U(0.975,1.045)\) p.u.&lt;br&gt;case69: fixed radial topology; \(V_s\sim U(0.98,1.04)\) p.u.&lt;/div&gt;" vertex="1">
          <mxGeometry height="113" width="326" x="14" y="271" as="geometry" />
        </mxCell>
        <mxCell id="g3" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=18;fontColor=#1F2933;align=center;verticalAlign=middle;spacing=6;shadow=0;gradientColor=none;shape=swimlane;horizontal=1;startSize=44;rounded=0;fillColor=#FBF3E8;swimlaneFillColor=#FFFFFF;strokeColor=#9A7854;strokeWidth=1.4;fontSize=20;fontStyle=1;collapsible=0;recursiveResize=0;container=1;resizeLast=0;" value="03 · Exact Physics, Targets and Telemetry" vertex="1">
